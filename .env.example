# Copie para .env e ajuste. Nunca versione o arquivo .env.

# --- Banco de dados (SQLite por padrão; PostgreSQL: postgresql+psycopg://usuario:senha@host:5432/safecat) ---
# SAFECAT_DATABASE_URL=sqlite:///./safecat.db

# --- Tabelas oficiais do eSocial importadas (ver README) ---
# SAFECAT_TABLES_DIR=./data-local/tabelas

# --- IA (opcional). Sem chave, o app roda em modo demonstração. ---
# ANTHROPIC_API_KEY=
# SAFECAT_LLM_MODEL=claude-opus-5-5
# SAFECAT_LLM_EFFORT=medium
# SAFECAT_LLM_TIMEOUT_SECONDS=60
# SAFECAT_LLM_MAX_RETRIES=2
# SAFECAT_LLM_MAX_TOKENS=8000
# SAFECAT_LLM_SERVER_FALLBACK=true
# SAFECAT_FORCE_DEMO=false

# --- Empregador impresso no documento auxiliar (vazio = "não informado") ---
# SAFECAT_EMPREGADOR_RAZAO_SOCIAL=
# SAFECAT_EMPREGADOR_CNPJ=
# SAFECAT_EMPREGADOR_CNAE=
# SAFECAT_EMPREGADOR_ENDERECO=

# --- Privacidade / operação ---
# SAFECAT_RETENTION_DAYS=0
# SAFECAT_LOG_LEVEL=INFO
